# ─────────────────────────────────────────────────────────────
#  POS V3 — Environment Configuration Template
#  Copy this file to .env (or set these vars in your shell /
#  Azure App Service "Application settings" panel).
#  NEVER commit a file with real secrets to source control.
# ─────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE-ME-32-char-random-string

# ── Server ────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8080

# ── Azure AD B2C / OIDC ───────────────────────────────────────
# Set USE_AZURE_AUTH=true to require Azure login instead of the
# built-in username/password flow.
USE_AZURE_AUTH=false

# Authority URL from your Azure AD B2C tenant, e.g.:
#   https://<tenant>.b2clogin.com/<tenant>.onmicrosoft.com/<policy>/v2.0
OIDC_AUTHORITY=

# Application (client) ID from Azure portal → App registrations
OIDC_CLIENT_ID=

# Client secret from Azure portal → App registrations → Certificates & secrets
OIDC_CLIENT_SECRET=

# Must match the Redirect URI registered in Azure portal exactly, e.g.:
#   http://localhost:8080/auth/callback          (dev)
#   https://yourapp.azurewebsites.net/auth/callback  (prod)
OIDC_REDIRECT_URI=http://localhost:8080/auth/callback

# Space-separated OIDC scopes (default is fine for most cases)
OIDC_SCOPE=openid profile email

# ── Billing / Stripe ──────────────────────────────────────────
# Set APP_ENFORCE_BILLING=true to block access when subscription lapses.
APP_ENFORCE_BILLING=false

# Number of days past_due users still have access (grace period)
BILLING_GRACE_DAYS=7

# Stripe keys — get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe Price ID for your monthly/annual plan
STRIPE_DEFAULT_PRICE_ID=price_...

# Stripe webhook signing secret — get from Stripe CLI or dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
